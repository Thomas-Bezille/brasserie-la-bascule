# =============================================================
# Brasserie La Bascule, variables d'environnement, MODÈLE
# Copier en .env.local et remplir. Ne jamais commiter de secret.
# Toute nouvelle variable doit être ajoutée ici le jour même.
# =============================================================

# --- Application ---
# URL publique du site, sans slash final
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Environnement : development | preview | production
APP_ENV=development

# --- Protection de la préproduction ---
# Tant que SITE_PUBLIE ne vaut pas "oui", le site est fermé par mot de passe
# et sert un noindex. À passer à "oui" le jour de la mise en ligne, et pas
# avant : c'est ce qui ouvre le site au public et aux moteurs de recherche.
SITE_PUBLIE=non
# Mot de passe de la préproduction, à définir dans Vercel et non ici.
# Laissé vide en local : la protection ne s'applique pas hors ligne.
# En ligne, une valeur absente ferme le site avec un 503 plutôt que de
# l'ouvrir en silence.
MOT_DE_PASSE_PREPROD=

# --- E-mails du formulaire (lot 2, hors périmètre du 25/09) ---
# Clé API du service d'envoi
MAIL_API_KEY=
# Expéditeur vérifié sur le domaine, créé au transfert de labascule.fr
MAIL_FROM=contact@labascule.fr
# Destinataire des messages. Voir la découverte du 15/09 : l'ancienne
# adresse n'était pas une boîte aux lettres, la destination se teste
# de bout en bout avant toute mise en ligne.
MAIL_TO=

# --- Agenda de réservation (niveau B, lot 3) ---
AGENDA_API_KEY=

# --- Mesure d'audience, sans cookie donc sans bandeau de consentement ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ATTENTION : côté Next.js, toute variable préfixée NEXT_PUBLIC_
# est exposée dans le navigateur. Aucun secret ne doit y figurer.
