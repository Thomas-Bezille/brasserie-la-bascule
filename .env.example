# =============================================================
# Brasserie La Bascule, variables d'environnement, MODÈLE
# Copier en .env.local et remplir. Ne jamais commiter de secret.
# Toute nouvelle variable doit être ajoutée ici le jour même.
# =============================================================

# --- Application ---
# URL publique du site, avec son protocole et sans slash final.
# Une valeur vide ou sans https:// est ignorée : le site se replie sur son
# domaine cible plutôt que d'échouer au build. Voir src/lib/url-site.test.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Environnement : development | preview | production
APP_ENV=development

# --- Protection de la préproduction ---
# Tant que SITE_PUBLIE ne vaut pas "oui", le site est fermé par mot de passe
# et sert un noindex. À passer à "oui" le jour de la mise en ligne, et pas
# avant : c'est ce qui ouvre le site au public et aux moteurs de recherche.
SITE_PUBLIE=non
# Mot de passe de la préproduction, à définir dans Vercel et non ici.
# Laissé vide en local : la protection ne s'applique pas hors ligne.
# En ligne, une valeur absente ferme le site avec un 503 plutôt que de
# l'ouvrir en silence.
MOT_DE_PASSE_PREPROD=

# --- Formulaire de contact ---
# Service d'envoi : resend | simulation
# Sans lui, il n'y a pas de formulaire : la page de contact le dit au visiteur
# au lieu d'afficher des champs qui n'enverraient rien. Comportement fermé par
# défaut, comme celui de l'agenda et de src/proxy.ts.
# `simulation` sert à développer sans compte ni domaine. Elle est refusée dès
# que SITE_PUBLIE vaut oui, et un test fait échouer la CI si cette garde saute.
# L'adaptateur `resend` n'est pas écrit : il lui faut le domaine labascule.fr
# transféré et un expéditeur vérifié.
MESSAGERIE_FOURNISSEUR=
# Clé API du service d'envoi
MAIL_API_KEY=
# Expéditeur vérifié sur le domaine, créé au transfert de labascule.fr
MAIL_FROM=contact@labascule.fr
# Destinataire des messages. Voir la découverte du 15/09 : l'ancienne
# adresse n'était pas une boîte aux lettres, la destination se teste
# de bout en bout avant toute mise en ligne.
MAIL_TO=

# --- Agenda de réservation (niveau B, vendu 600 €) ---
# Fournisseur : meetergo | calcom | simulation
# Sans lui, il n'y a pas d'agenda : la page de réservation le dit au visiteur
# au lieu d'afficher un formulaire qui n'enregistrerait rien. Comportement
# fermé par défaut, comme celui de src/proxy.ts.
# `simulation` sert à développer sans compte ouvert. Elle est refusée dès que
# SITE_PUBLIE vaut oui, et un test fait échouer la CI si cette garde saute.
# Le choix entre meetergo et calcom n'est pas arrêté : voir la note
# 03-conception/decision-agenda-reservation.md du dossier projet.
AGENDA_FOURNISSEUR=
# Jeton de l'agenda. Ne quitte jamais le serveur : aucun appel au prestataire
# n'est fait depuis le navigateur, ce qui évite aussi les cookies tiers et le
# bandeau de consentement que tout le site s'applique à ne pas avoir.
AGENDA_CLE_API=

# --- Mesure d'audience, sans cookie donc sans bandeau de consentement ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ATTENTION : côté Next.js, toute variable préfixée NEXT_PUBLIC_
# est exposée dans le navigateur. Aucun secret ne doit y figurer.
